# ================================================================
# Meeting Intelligence Assistant — Environment Variables Template
# Copy this file to .env and fill in your values
# ================================================================

# ------------------------------------------------------------------
# LLM / MODEL ACCESS
# ------------------------------------------------------------------

# HuggingFace token for downloading gated models (Qwen2.5-Omni-7B)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# Groq API key — used as fallback LLM when local model unavailable
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# ------------------------------------------------------------------
# MODEL CONFIGURATION
# ------------------------------------------------------------------

# Primary multimodal model
MODEL_NAME=Qwen/Qwen2.5-Omni-7B

# Whisper model size (tiny | base | small | medium | large-v2 | large-v3)
WHISPER_MODEL=large-v3

# ------------------------------------------------------------------
# HARDWARE / DEVICE
# ------------------------------------------------------------------

# Device for inference: "cuda" for GPU, "cpu" for CPU-only fallback
DEVICE=cuda

# GPU memory threshold in GB — if VRAM < this, use 4-bit quantization
GPU_MEMORY_THRESHOLD=20

# Number of CPU threads for CPU-only inference
CPU_THREADS=8

# ------------------------------------------------------------------
# STORAGE PATHS
# ------------------------------------------------------------------

# ChromaDB vector store path
CHROMA_PATH=./chroma_db

# Directory for extracted video frames
FRAMES_DIR=./extracted_frames

# Directory for extracted slide images
SLIDES_DIR=./extracted_slides

# ------------------------------------------------------------------
# VIDEO PROCESSING
# ------------------------------------------------------------------

# Extract 1 frame every N seconds from video
FRAME_INTERVAL=30

# Maximum number of frames to extract (safety limit)
MAX_FRAMES=50

# Pixel difference threshold to detect slide transitions (0-255)
SLIDE_TRANSITION_THRESHOLD=30

# ------------------------------------------------------------------
# API SERVER
# ------------------------------------------------------------------

# FastAPI backend host and port
API_HOST=0.0.0.0
API_PORT=8000

# Gradio UI host and port
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# FastAPI backend URL (used by Gradio to call the API)
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------
# PROCESSING
# ------------------------------------------------------------------

# Maximum audio duration in minutes before chunking
MAX_AUDIO_MINUTES=120

# Chunk size for transcript indexing (in characters)
CHUNK_SIZE=500

# Overlap between chunks (in characters)
CHUNK_OVERLAP=50

# Number of top results to retrieve from ChromaDB per query
TOP_K_RESULTS=5

# ------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path (empty = console only)
LOG_FILE=./logs/app.log
